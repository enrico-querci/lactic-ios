# See https://git-scm.com/docs/gitattributes

# Normalise line endings for text we author.
* text=auto eol=lf

# Xcode string catalogs are JSON; keep them diffable but never merged blindly.
*.xcstrings text merge=union

# Captured HTTP header dumps. Real headers are CRLF-terminated, so normalising
# them to LF would misrepresent what the server actually sent.
*.headers -text

# Binary assets.
*.png binary
*.jpg binary
*.pdf binary
*.gif binary
