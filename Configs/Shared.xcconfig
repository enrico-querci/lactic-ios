// Shared build settings for every target in lactic-ios.
//
// These files are the source of truth for build settings, NOT the Xcode UI.
// The .xcodeproj is regenerated by `make project`, so any setting changed
// through Xcode's build-settings editor is silently discarded on the next run.
// Change it here instead.

// Minimum target: iOS 18.0. Building against the iOS 26 SDK means both apps
// still adopt Liquid Glass on iOS 26+ devices while running on iOS 18, so long
// as every iOS 19+ API stays behind an @available check.
IPHONEOS_DEPLOYMENT_TARGET = 18.0

SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_EMIT_LOC_STRINGS = YES

ALWAYS_SEARCH_USER_PATHS = NO
CLANG_ENABLE_MODULES = YES
CLANG_ENABLE_OBJC_ARC = YES
ENABLE_STRICT_OBJC_MSGSEND = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
GCC_NO_COMMON_BLOCKS = YES

CLANG_WARN_DOCUMENTATION_COMMENTS = YES
CLANG_WARN_UNGUARDED_AVAILABILITY = YES_AGGRESSIVE
GCC_WARN_ABOUT_MISSING_NEWLINE = YES
GCC_WARN_SHADOW = YES

DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Automatic
