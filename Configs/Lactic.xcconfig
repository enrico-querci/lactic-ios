// Lactic — the client-facing iPhone app.

PRODUCT_NAME = Lactic
PRODUCT_BUNDLE_IDENTIFIER = com.enricoquerci.lactic
PRODUCT_MODULE_NAME = Lactic
CURRENT_PROJECT_VERSION = 1
MARKETING_VERSION = 0.1.0

// 1 = iPhone. Lactic is a phone app; Lactic Studio is the iPad one.
TARGETED_DEVICE_FAMILY = 1
INFOPLIST_KEY_UISupportedInterfaceOrientations = UIInterfaceOrientationPortrait

INFOPLIST_KEY_CFBundleDisplayName = Lactic
INFOPLIST_KEY_UILaunchScreen_Generation = YES
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
